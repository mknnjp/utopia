{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts session-start",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts session-start",
        "timeoutSec": 1800
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts record-human-turn",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts record-human-turn",
        "timeoutSec": 1800
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts guard-tool-call",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts guard-tool-call",
        "timeoutSec": 1800
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts post-tool",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts post-tool",
        "timeoutSec": 3600
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts validate-state",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts validate-state",
        "timeoutSec": 1800
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts subagent-start",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts subagent-start",
        "timeoutSec": 1800
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts log-subagent",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts log-subagent",
        "timeoutSec": 1800
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "bun .aidlc/hooks/aidlc-copilot-adapter.ts continue-workflow",
        "powershell": "bun .aidlc/hooks/aidlc-copilot-adapter.ts continue-workflow",
        "timeoutSec": 3600
      }
    ]
  }
}
