APP_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://utopia:utopia@localhost:5432/utopia?sslmode=require

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

TOKEN_CACHE_TTL_SECS=60
NEGATIVE_TOKEN_CACHE_TTL_SECS=60
TOKEN_CACHE_MAX_CAPACITY=10000

BOOTSTRAP_KEY=replace-me-with-long-random-bootstrap-secret
BOOTSTRAP_USER_EMAIL=bootstrap@utopia.local

# Security: set to "false" to allow sslmode=disable (local dev only)
APP_STRICT_SSL=true

# Rate limiting for bootstrap token endpoint
# Default: 5 requests per 60 seconds per IP
APP_RATE_LIMIT_BOOTSTRAP_REQUESTS=5
APP_RATE_LIMIT_BOOTSTRAP_WINDOW_SECS=60

# --- Compatibility Verification Suite (k6) ---
# Base URL for k6 test runner to target
APP_BASE_URL=http://localhost:80
# Directory for k6 output artifacts (JSON reports)
K6_OUTPUT_DIR=./results/compatibility
